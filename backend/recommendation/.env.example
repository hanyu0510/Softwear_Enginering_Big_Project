# 复制配置值到运行环境；标准库版本不会自动加载 .env 文件。
# catalog_live_weather = 模拟账号 + 本地商品样本 + Open-Meteo 真实天气
RECOMMENDATION_MODE=catalog_live_weather
# 可选；默认使用仓库内 backend/recommendation/fixtures/garment
GARMENT_DATASET_DIR=
RECOMMENDATION_HOST=127.0.0.1
RECOMMENDATION_PORT=8010
RECOMMENDATION_DB_PATH=recommendation/data/recommendation.sqlite3
# live 模式当前只支持 Open-Meteo；无密钥的公开端点。
WEATHER_PROVIDER=open_meteo
WEATHER_BASE_URL=https://api.open-meteo.com
WEATHER_TIMEOUT_SECONDS=5
WEATHER_API_KEY=
# 如需模型精排，使用兼容 chat/completions 的 JSON 服务。
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=8
# 可选：JSON，所有权重非负且总和为 1。
# RECOMMENDATION_WEIGHTS={"weather":0.25,"occasion":0.15,"style":0.16,"color":0.12,"preference":0.12,"practicality":0.12,"completeness":0.08}
