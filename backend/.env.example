APP_ENV=development
DATABASE_URL=sqlite:///./data/yida.db
UPLOAD_DIR=./data/uploads
MAX_IMAGE_BYTES=10485760
WARDROBE_AI_PROVIDER=disabled

# 账号模块（共用 DATABASE_URL，禁止另建用户库）
ACCOUNT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000
ACCOUNT_COOKIE_SECURE=false
ACCOUNT_TEST_PAGE=true
ACCOUNT_COLOR_NAMES=
